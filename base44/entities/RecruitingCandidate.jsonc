{
  "name": "RecruitingCandidate",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "territory": {
      "type": "string"
    },
    "campaign_source": {
      "type": "string"
    },
    "campaign_medium": {
      "type": "string"
    },
    "campaign_name": {
      "type": "string"
    },
    "landing_path": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "current_role": {
      "type": "string"
    },
    "business_relationships": {
      "type": "string"
    },
    "interest_reason": {
      "type": "string",
      "description": "What the candidate found on NTA that made them want to know more"
    },
    "business_observation": {
      "type": "string",
      "description": "How the candidate naturally notices opportunities or friction in a business"
    },
    "nta_questions": {
      "type": "string",
      "description": "Questions the candidate has after exploring NTA"
    },
    "status": {
      "type": "string",
      "enum": [
        "New Lead",
        "Contacted",
        "In Review",
        "Qualified",
        "Not a Fit"
      ],
      "default": "New Lead"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes or description"
    }
  },
  "required": [
    "full_name",
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}