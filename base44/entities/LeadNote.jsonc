{
  "name": "LeadNote",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string",
      "description": "Reference to Lead ID"
    },
    "note": {
      "type": "string",
      "description": "Note content"
    },
    "note_type": {
      "type": "string",
      "enum": [
        "call",
        "email",
        "meeting",
        "follow_up",
        "general"
      ],
      "default": "general",
      "description": "Type of interaction"
    },
    "author": {
      "type": "string",
      "description": "Who wrote this note (email or name)"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes or description"
    }
  },
  "required": [
    "lead_id",
    "note"
  ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
