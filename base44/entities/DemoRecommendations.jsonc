{
  "name": "DemoRecommendations",
  "type": "object",
  "properties": {
    "prospect_id": {
      "type": "string"
    },
    "demo_session_id": {
      "type": "string"
    },
    "recommendation_type": {
      "type": "string",
      "enum": [
        "next_step",
        "recommended_video",
        "recommended_plan",
        "recommended_action"
      ],
      "default": "next_step"
    },
    "recommendation_text": {
      "type": "string"
    },
    "recommended_asset_id": {
      "type": "string"
    },
    "recommended_path": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes or description"
    }
  },
  "required": [
    "recommendation_type",
    "active"
  ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
