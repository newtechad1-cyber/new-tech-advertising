{
  "name": "Permissions",
  "type": "object",
  "properties": {
    "permission_key": {
      "type": "string",
      "description": "Machine key, e.g. view_billing, manage_users"
    },
    "permission_label": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "dashboard",
        "billing",
        "content",
        "analytics",
        "settings",
        "reseller",
        "admin"
      ]
    },
    "description": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "permission_key",
    "permission_label",
    "category",
    "active"
  ]
,
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
