{
  "name": "PricingWizardLead",
  "type": "object",
  "properties": {
    "industry": {
      "type": "string"
    },
    "current_marketing": {
      "type": "string"
    },
    "time_available": {
      "type": "string"
    },
    "primary_goal": {
      "type": "string"
    },
    "budget_comfort": {
      "type": "string"
    },
    "recommended_plan": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_url": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "industry",
    "primary_goal"
  ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
