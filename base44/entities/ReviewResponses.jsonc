{
  "name": "ReviewResponses",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Reference to ClientCompanies ID"
    },
    "review_id": {
      "type": "string",
      "description": "Reference to Reviews ID"
    },
    "response_text": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "ai_generated",
        "human_written",
        "template"
      ],
      "default": "ai_generated"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "published",
        "rejected"
      ],
      "default": "draft"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by": {
      "type": "string",
      "description": "User email who approved"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes or description"
    }
  },
  "required": [
    "company_id",
    "review_id",
    "response_text",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
