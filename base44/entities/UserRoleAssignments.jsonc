{
  "name": "UserRoleAssignments",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to Users ID"
    },
    "role_id": {
      "type": "string",
      "description": "Reference to Roles ID"
    },
    "company_id": {
      "type": "string",
      "description": "Reference to ClientCompanies ID — null for platform-wide roles"
    },
    "reseller_id": {
      "type": "string",
      "description": "Reference to ResellerAccounts ID — null for non-reseller roles"
    },
    "granted_by": {
      "type": "string",
      "description": "User email who granted this role"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Optional expiry"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes or description"
    }
  },
  "required": [
    "user_id",
    "role_id",
    "active"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
