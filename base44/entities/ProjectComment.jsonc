{
  "name": "ProjectComment",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID of the parent project"
    },
    "content": {
      "type": "string",
      "description": "Message content"
    },
    "sender_name": {
      "type": "string",
      "description": "Name of the sender"
    },
    "is_manager": {
      "type": "boolean",
      "default": false,
      "description": "Whether the sender is an account manager"
    }
  },
  "required": [
    "project_id",
    "content"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}