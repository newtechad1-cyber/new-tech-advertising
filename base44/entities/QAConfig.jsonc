{
  "name": "QAConfig",
  "type": "object",
  "properties": {
    "config_key": {
      "type": "string",
      "description": "Unique config key e.g. issue_severities"
    },
    "config_value": {
      "type": "string",
      "description": "JSON array or string value"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "config_key",
    "config_value"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
