{
  "name": "StarterPortalModule",
  "type": "object",
  "properties": {
    "trial_signup_id": {
      "type": "string"
    },
    "module_key": {
      "type": "string"
    },
    "module_label": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "trial_signup_id",
    "module_key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
