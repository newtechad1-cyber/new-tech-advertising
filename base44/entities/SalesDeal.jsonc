{
  "name": "SalesDeal",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string",
      "description": "Reference to SalesLead ID"
    },
    "deal_name": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "New Lead",
        "Contacted",
        "Demo Sent",
        "Proposal",
        "Closed Won",
        "Closed Lost"
      ],
      "default": "New Lead"
    },
    "value": {
      "type": "number",
      "description": "Estimated deal value in USD"
    },
    "notes": {
      "type": "string"
    },
    "archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "lead_id",
    "deal_name"
  ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
