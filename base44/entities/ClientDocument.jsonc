{
  "name": "ClientDocument",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "business_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "Intake Form",
        "Brand Assets",
        "Tax Form",
        "Report",
        "Other"
      ],
      "default": "Other"
    },
    "file_url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "title",
    "file_url"
  ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
