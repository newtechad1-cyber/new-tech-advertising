{
  "name": "Prospect",
  "type": "object",
  "properties": {
    "business_name": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "audit_requested",
        "qualified",
        "converted",
        "not_a_fit"
      ],
      "default": "new"
    },
    "notes": {
      "type": "string"
    },
    "audit_status": {
      "type": "string",
      "enum": [
        "none",
        "requested",
        "in_progress",
        "completed"
      ],
      "default": "none"
    }
  },
  "required": [
    "business_name"
  ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
