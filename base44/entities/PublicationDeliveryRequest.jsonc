{
  "name": "PublicationDeliveryRequest",
  "type": "object",
  "properties": {
    "subscriber_id": { "type": "string" },
    "email": { "type": "string" },
    "first_name": { "type": "string" },
    "publication_tag": { "type": "string" },
    "publication_title": { "type": "string" },
    "source": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["queued", "sent", "failed"],
      "default": "queued"
    },
    "requested_at": { "type": "string", "format": "date-time" },
    "sent_at": { "type": "string", "format": "date-time" },
    "delivery_url": { "type": "string" },
    "error_message": { "type": "string", "maxLength": 1000 },
    "delivery_attempts": { "type": "integer", "default": 0 }
  },
  "required": ["email", "publication_tag", "publication_title", "status", "requested_at"]
}
