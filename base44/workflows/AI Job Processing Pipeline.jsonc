{
  "name": "AI Job Processing Pipeline",
  "description": "Process pending AI jobs by invoking processAIJobsAutomation when AIJobs status is pending",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "AIJobs"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "ai_job_processing_pipeline",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processAIJobsAutomation",
            "args": {
              "job_id": "{{entity_id}}"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "processAIJobsAutomation"
  }
}