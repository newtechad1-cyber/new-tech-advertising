{
  "name": "Content Asset \u2014 Queue for Approval When Ready",
  "description": "When a content asset status changes to ready, set approval_status to pending",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"ready\") and (.trigger.changed_fields | index(\"status\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ContentAsset"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "content_asset_queue_for_approval_when_ready",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "ntaApprovalWorkflow",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "ntaApprovalWorkflow"
  }
}