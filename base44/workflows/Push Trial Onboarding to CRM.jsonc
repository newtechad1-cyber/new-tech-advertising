{
  "name": "Push Trial Onboarding to CRM",
  "description": "When a BrandDNA record is created (trial onboarding submitted), push all account + brand DNA data to the CRM webhook and send an internal notification email.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "BrandDNA"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "push_trial_onboarding_to_crm",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendTrialToCRM",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendTrialToCRM"
  }
}